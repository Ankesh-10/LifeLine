# Lifeline environment template. Copy to .env (scripts/setup.sh does this for you).
# Everything here is for a SIMULATED demo. Never point it at a real emergency system.

# --- Database (Postgres + PostGIS) ---
POSTGRES_USER=lifeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifeline
POSTGRES_PORT=5432

# --- n8n ---
N8N_PORT=5678
# setup.sh generates this if left empty. Never change it after first run, or saved credentials become unreadable.
N8N_ENCRYPTION_KEY=
# Public URL n8n uses for webhooks and Wait-node resume links (e.g. a cloudflared tunnel URL).
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# --- Messaging ---
TELEGRAM_BOT_TOKEN=
# Telegram chat that receives approval requests.
COORDINATOR_CHAT_ID=

# --- LLM (free-tier provider, not final; keep swappable) ---
# e.g. gemini | groq | openrouter | ollama
LLM_PROVIDER=
LLM_API_KEY=
# Must support vision + JSON output.
LLM_MODEL_EXTRACT=
# Small, fast model for reply classification.
LLM_MODEL_CLASSIFY=

# --- Feeds ---
# Mock feed server from sim/mock-feeds.js; swap for a real weather API later.
WEATHER_API_URL=http://host.docker.internal:4010

# --- Mode ---
# true = simulated feeds/responders, pre-recorded extractions allowed as fallback.
SIM_MODE=true
