# Lifeline environment template. Copy to .env (scripts/setup.sh does this for you).
# Everything here is for a SIMULATED demo. Never point it at a real emergency system.

# --- Database (Postgres + PostGIS) ---
POSTGRES_USER=lifeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifeline
POSTGRES_PORT=5432

# --- n8n ---
N8N_PORT=5678
# setup.sh generates this if left empty. Never change it after first run, or saved credentials become unreadable.
N8N_ENCRYPTION_KEY=
# Public URL n8n uses for webhooks and Wait-node resume links (e.g. a cloudflared tunnel URL).
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# --- Messaging ---
TELEGRAM_BOT_TOKEN=
# Optional: secret_token you pass to Telegram setWebhook; 01-ingest drops updates without it.
TELEGRAM_WEBHOOK_SECRET=
# Telegram chat that receives approval requests.
COORDINATOR_CHAT_ID=

# --- LLM (free-tier provider, not final; keep swappable) ---
# e.g. gemini | groq | openrouter | ollama (all OpenAI-compatible; see core/src/llm.js)
LLM_PROVIDER=
# Only for other OpenAI-compatible providers; known providers fill this in.
LLM_BASE_URL=
LLM_API_KEY=
# Must support vision + JSON output.
LLM_MODEL_EXTRACT=
# Small, fast model for reply classification.
LLM_MODEL_CLASSIFY=

# --- Feeds ---
# Mock feed server from sim/mock-feeds.js; swap for a real weather API later.
WEATHER_API_URL=http://host.docker.internal:4010

# --- Mode ---
# true = simulated feeds/responders, pre-recorded extractions allowed as fallback.
SIM_MODE=true
# SIMULATED responder bot (sim/responder-bot.js) that 04-dispatch posts to for sim-* resources.
SIM_BOT_URL=http://host.docker.internal:4020

# --- Human in the loop ---
# Override core/config/policy.json mode: manual | assisted | autonomous (empty = file default).
POLICY_MODE=
APPROVAL_TIMEOUT_MINUTES=5
# Watchdog timeouts in minutes. Demo: 1 / 1 / 2 so the silent-boat beat happens within the replay.
WATCHDOG_ACK_MINUTES=5
WATCHDOG_HEARTBEAT_MINUTES=15
WATCHDOG_CONFIRM_MINUTES=30
