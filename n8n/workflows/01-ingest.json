{
  "id": "lifeline01ingest",
  "name": "01-ingest",
  "nodes": [
    {
      "name": "Replay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "7162b96b-f64b-5ebd-ad9f-286a548cdd53",
      "parameters": {
        "httpMethod": "POST",
        "path": "lifeline/replay",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "9c6644c0-b94b-5442-a78c-76dd926a9c29"
    },
    {
      "name": "Telegram webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "d7fd283e-1149-5d38-ab78-be5344e14a68",
      "parameters": {
        "httpMethod": "POST",
        "path": "lifeline/telegram",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "9cb6c7d5-e655-563d-ac20-df1821c05479"
    },
    {
      "name": "Normalize replay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// SIMULATED scenario message from sim/replay.js.\nconst core = require('lifeline-core');\nreturn { json: { draft: core.ingest.fromReplay($json.body) } };"
      },
      "id": "624e9bc0-f515-5521-a1a0-8b5a8c564ce0"
    },
    {
      "name": "Normalize Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const core = require('lifeline-core');\nreturn $input.all().flatMap((item) => {\n  if (!core.ingest.telegramAuthorized(item.json.headers, $env)) return [];\n  const draft = core.ingest.fromTelegram(item.json.body);\n  return draft ? [{ json: { draft } }] : [];\n});"
      },
      "id": "b07f47c9-c1ba-53ee-af07-535fdefd5aa1"
    },
    {
      "name": "Has photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "f64a1bba-6a08-549a-a282-e90f37153757",
              "leftValue": "={{ Boolean($json.draft.media && $json.draft.media.telegramFileId) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d236856e-6182-5e15-ab1a-29894c47926e"
    },
    {
      "name": "Telegram getFile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/getFile?file_id=' + encodeURIComponent($json.draft.media.telegramFileId) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "eb6d0b58-5999-5fe7-a3a7-d58da097dce7"
    },
    {
      "name": "Download photo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.telegram.org/file/bot' + $env.TELEGRAM_BOT_TOKEN + '/' + $json.result.file_path }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "f3f64cc8-19e9-596e-a4af-974425982c3b"
    },
    {
      "name": "Attach photo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "jsCode": "// The photo goes to the vision model as a data URL; it is never stored.\nconst core = require('lifeline-core');\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const draft = $('Normalize Telegram').itemMatching(i).json.draft;\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  out.push({ json: { draft: core.ingest.attachPhoto(draft, buffer.toString('base64'), items[i].binary?.data?.mimeType) } });\n}\nreturn out;"
      },
      "id": "4fb2abe9-6009-563a-a929-f1c05621795d"
    },
    {
      "name": "Cache key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const core = require('lifeline-core');\nreturn { json: { draft: $json.draft, hashArg: core.pipeline.sqlJson(core.ingest.extractionKey($json.draft, $env)) } };"
      },
      "id": "7b1363c2-333a-592f-a0a2-b4a3cb05ecbb"
    },
    {
      "name": "Lookup cache",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT (SELECT jsonb_build_object('extracted', extracted, 'model', model) FROM extraction_cache WHERE hash = ({{ $json.hashArg }}::jsonb #>> '{}')) AS cached",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "lifelinePostgres1",
          "name": "Lifeline DB"
        }
      },
      "id": "c80a5686-e887-5055-a7d8-89d990606ac3"
    },
    {
      "name": "Plan extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// cache -> LLM -> SIMULATED hint (SIM_MODE) -> coordinator queue\nconst core = require('lifeline-core');\nreturn { json: core.ingest.planExtraction({ draft: $('Cache key').item.json.draft, cached: $json.cached, env: $env }) };"
      },
      "id": "4990be0b-2df6-56e1-a1b3-63bde7211abe"
    },
    {
      "name": "Needs LLM?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "374fb14d-feed-5e0d-a275-8dd35cf08eb8",
              "leftValue": "={{ $json.route }}",
              "rightValue": "llm",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "118f3e4e-3d66-59d0-a68c-c4478ad4f722"
    },
    {
      "name": "Call LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.llm.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.llm.body) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "id": "cca75b6b-360a-5d84-a5cb-c971f2537988"
    },
    {
      "name": "Check extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Validate against the extraction schema; one retry, then fall back.\nconst core = require('lifeline-core');\nconst plan = $('Plan extraction').item.json;\nreturn { json: core.ingest.acceptExtraction({ plan, response: $json, attempt: $runIndex + 1 }) };"
      },
      "id": "8d0f1240-1b1a-562e-a9c9-050c81d2c253"
    },
    {
      "name": "Retry LLM?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "d52b85a3-56ba-536d-a259-2f70de51b008",
              "leftValue": "={{ $json.route }}",
              "rightValue": "retry",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b13025d8-41ef-5f90-a966-3d6cf82ecc0e"
    },
    {
      "name": "Finalize report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const core = require('lifeline-core');\nreturn { json: { sqlArg: core.pipeline.sqlJson(core.ingest.finalizeReport($json)) } };"
      },
      "id": "afbd7597-9009-5f5c-aaaf-d0712dfaafc9"
    },
    {
      "name": "Save report",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3080,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT lifeline_ingest_report({{ $json.sqlArg }}::jsonb) AS result",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "lifelinePostgres1",
          "name": "Lifeline DB"
        }
      },
      "id": "336c09c8-99af-5e7b-acb5-199c77b61128"
    }
  ],
