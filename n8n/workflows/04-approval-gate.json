      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Resumed by a link (query has decision + token) or by the timeout (no query).\nconst core = require('lifeline-core');\nconst req = $('Prepare request').item.json;\nconst plan = core.pipeline.planApproval({ dispatch: req.dispatch, query: $json.query, expectedToken: req.token, timedOut: !$json.query, now: new Date().toISOString() });\nreturn { json: { sqlArg: core.pipeline.sqlJson(plan) } };"
      },
      "id": "380b4a1b-b363-5887-af88-488df3826c5a"
    },
