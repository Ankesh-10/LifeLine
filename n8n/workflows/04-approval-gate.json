            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c68f70f3-8b65-51c7-a873-cc7ba7d2593b",
              "leftValue": "={{ $('Prepare request').item.json.notice.channel }}",
              "rightValue": "telegram",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "328e2fe6-3ac7-57b2-aabc-b6cf9c47e7ee"
    },
