        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": "={{ $('Prepare request').item.json.timeoutMinutes }}",
        "resumeUnit": "minutes",
        "options": {}
      },
      "id": "5eaa5cf9-bfab-5623-a850-5601c07717e9"
    },
