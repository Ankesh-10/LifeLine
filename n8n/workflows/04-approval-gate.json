        "jsCode": "const core = require('lifeline-core');\nconst d = $('Prepare delivery').item.json;\nconst response = d.delivery.channel === 'none' ? {} : $json;\nreturn { json: { sqlArg: core.pipeline.sqlJson(core.pipeline.deliveryEvent(d, d.delivery, response)) } };"
