    {
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One execution per approval, so each request has its own resume URL.\nconst core = require('lifeline-core');\nconst d = $json;\nconst token = core.messages.newApprovalToken();\nconst links = core.messages.approvalLinks($execution.resumeUrl, token);\nconst notice = core.messages.coordinatorNotice(core.messages.approvalText(d, links), $env);\nconst timeoutMinutes = Number($env.APPROVAL_TIMEOUT_MINUTES) || d.approvalTimeoutMinutes || 5;\nconst record = { dispatchId: d.dispatchId, url: $execution.resumeUrl, token, channel: notice.channel, timeoutMinutes, reasons: (d.approvalReasons || []).join('; ') };\nreturn { json: { dispatch: d, token, notice, timeoutMinutes, sqlArg: core.pipeline.sqlJson(record) } };"
      },
      "id": "0a4aa360-c8b7-57bc-a3e0-b37ed50c07e5"
    },
    {
      "name": "Store approval link",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT lifeline_set_approval({{ $json.sqlArg }}::jsonb) AS result",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "lifelinePostgres1",
          "name": "Lifeline DB"
        }
      },
      "id": "9c26d4e5-2abd-57fc-aa49-763134610c88"
    },
    {
      "name": "Telegram configured?",
