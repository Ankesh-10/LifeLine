      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// lifecycle decides: heartbeat, re-route, close (needs both confirmations).\nconst core = require('lifeline-core');\nconst ctx = $('Load context').item.json.ctx;\nconst effects = core.pipeline.planReplyEffects({\n  role: ctx.reply.role, intent: $json.intent, intentSource: $json.intentSource, text: ctx.reply.text,\n  dispatch: ctx.dispatch, incident: ctx.incident, resource: ctx.resource, replyLocation: ctx.reply.location,\n  now: new Date().toISOString(),\n});\nreturn { json: { sqlArg: core.pipeline.sqlJson(effects) } };"
      },
      "id": "bc3ed5f7-5735-56a5-abf3-471fcd394b74"
