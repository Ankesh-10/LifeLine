        "jsCode": "const core = require('lifeline-core');\nreturn ($input.first().json.result.notices || [])\n  .map((text) => core.messages.coordinatorNotice(text, $env))\n  .filter((n) => n.channel === 'telegram')\n  .map((notice) => ({ json: { notice } }));"
